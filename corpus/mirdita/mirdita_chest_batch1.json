      "provenance": "Mirdita native observation",
      "comparative_data": {
        "proto_albanian": null,
        "pie_root": "Debated; NOT *mēns- (that root gives Albanian muaj 'month')",
        "cognates": [],
        "diagnostic_status": "OPEN",
        "superseded": {
          "proto_albanian": "*sāndnā-",
          "pie_root": "*mēns- (moon, month)",
          "cognates": [
            "Latin mēnsis",
            "Ancient Greek μήν (mēn)",
            "English moon"
          ],
          "diagnostic_status": "CLASSIC GHEG NASALIZATION"
        },
        "review": {
          "status": "CORRECTED",
          "note": "The *mēns- cognates (Latin mēnsis, Greek mēn, English moon) belong to muaj 'month', not hënë/hân 'moon'. The etymology of hënë is debated; one proposal links it to a root meaning 'to shine'. The nasal vowel of hân is a Gheg observation, kept as such.",
          "reviewed": "2026-11-18",
          "rule": "GOLD-INV-03"
        }
      }
    },
